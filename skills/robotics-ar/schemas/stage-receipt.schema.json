{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robotics-ar-stage-receipt.v1",
  "type": "object",
  "required": ["schema_version", "session_id", "stage", "native_artifact", "handoff_status", "created_at"],
  "properties": {
    "schema_version": {"const": "robotics-ar-stage-receipt.v1"},
    "session_id": {"type": "string"},
    "stage": {"enum": ["idea", "experiment", "engineering", "writing", "review"]},
    "native_artifact": {"type": "object", "required": ["path", "sha256", "validator", "validation_status"], "properties": {"path": {"type": "string"}, "schema_version": {"type": "string"}, "sha256": {"type": "string"}, "validator": {"type": "string"}, "validation_status": {"enum": ["PASS", "FAIL", "BLOCKED"]}}, "additionalProperties": true},
    "handoff_status": {"enum": ["READY", "REVISE", "BLOCKED", "STOPPED"]},
    "created_at": {"type": "string"},
    "domain_payload": {"type": "object"}
  },
  "additionalProperties": true
}
