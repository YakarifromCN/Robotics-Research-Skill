"""Small CLI validator for the 15/31 ResearchStudio pattern library."""

from __future__ import annotations

import argparse

from common.researchstudio_patterns import DEFAULT_LIBRARY, load_pattern_library, validate_pattern_library


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate the robotics ResearchStudio pattern library.")
    parser.add_argument("--path", default=str(DEFAULT_LIBRARY))
    args = parser.parse_args()
    errors = validate_pattern_library(load_pattern_library(args.path))
    if errors:
        for error in errors:
            print("ERROR:", error)
        return 1
    print("RESEARCHSTUDIO_PATTERN_LIBRARY: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
